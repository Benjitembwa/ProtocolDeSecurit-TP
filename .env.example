NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
# Required in every environment. Get these credentials from Atlas > Database Access.
# Replace both placeholders; percent-encode special characters in credentials.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xdljzqj.mongodb.net/sentinel?appName=Cluster0&retryWrites=true&w=majority
MONGODB_DB_NAME=sentinel
# Optional: explicit DNS resolvers for Node.js only, if SRV lookup fails.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional in development, required in production: at least 48 random characters.
# JWT_SECRET=
# Required for the first seed in production; demo accounts are disabled there.
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=
