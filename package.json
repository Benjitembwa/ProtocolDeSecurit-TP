{
  "name": "sentinel-resilience-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"node --watch server/index.js\" \"vite --configLoader native --host 127.0.0.1\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --configLoader native --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "seed": "node server/seed.js",
    "db:check": "node scripts/check-database.js",
    "check": "npm run build && npm test",
    "format": "prettier --write src server scripts tests docs *.md *.json *.js",
    "format:check": "prettier --check src server scripts tests docs *.md *.json *.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tailwindcss/vite": "^4.1.0",
    "axios": "^1.12.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^12.23.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "vite": "^7.1.0"
  }
}
